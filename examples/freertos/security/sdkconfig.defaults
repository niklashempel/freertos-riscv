CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# Enable stack protection for compiler
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y

# Task watchdog - disable during development
# CONFIG_ESP_TASK_WDT_EN is not set

# Increase stack sizes to prevent legitimate overflows
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072

# Disable some protections for testing
CONFIG_COMPILER_STACK_CHECK_MODE_NONE=y